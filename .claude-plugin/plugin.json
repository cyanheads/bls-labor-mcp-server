{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "bls-labor-mcp-server",
  "version": "0.5.5",
  "description": "Fetch US Bureau of Labor Statistics data — CPI, unemployment, wages, JOLTS, and more via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/bls-labor-mcp-server#readme",
  "repository": "https://github.com/cyanheads/bls-labor-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "bls",
    "bureau-of-labor-statistics",
    "cpi",
    "unemployment",
    "wages",
    "jolts",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "userConfig": {
    "BLS_API_KEY": {
      "type": "string",
      "title": "BLS API key",
      "description": "Optional. 25 requests/day without a key, 500 with one plus calculations and annual averages. Register free at bls.gov/developers.",
      "sensitive": true,
      "default": ""
    }
  },
  "mcpServers": {
    "bls-labor-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/bls-labor-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "BLS_API_KEY": "${user_config.BLS_API_KEY}"
      }
    }
  }
}
