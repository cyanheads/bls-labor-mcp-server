# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # auto | stateful | stateless (schema default: auto; auto resolves stateful)
# MCP_HTTP_MAX_BODY_BYTES=1048576   # Max inbound request body in bytes (default 1 MiB). Set 0 to disable and defer to reverse proxy.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── BLS API ──────────────────────────────────────────────────────────
# BLS_API_KEY=                        # BLS v2 API key — optional (25 req/day without, 500/day with). Register free at bls.gov/developers
# BLS_BASE_URL=https://api.bls.gov/publicAPI/v2     # BLS API v2 base URL
# BLS_CATALOG_BASE_URL=https://download.bls.gov/pub/time.series  # LABSTAT flat-file base URL (override for local mirror)
# BLS_CATALOG_DB_PATH=.cache/bls-catalog.db         # On-disk SQLite catalog index, queried on demand; empty uses an in-memory DB. Mount a volume here in containers.
# BLS_CATALOG_CACHE_TTL_HOURS=168                   # Catalog freshness window in hours — re-harvest once older (default: 168h / 7 days)
# BLS_CATALOG_INCLUDE_OES=false                     # Include the OES/OEWS wage survey (~6M series / ~1.2 GB); off by default. OES stays fetchable by ID.
# BLS_DATASET_TTL_SECONDS=86400       # Per-dataframe TTL in seconds (default: 24h)
# BLS_DATAFRAME_DROP_ENABLED=false    # Expose bls_dataframe_drop (default: false; TTL handles cleanup)
# BLS_USER_AGENT=cyanheads-bls-mcp/1.0 (https://github.com/cyanheads/bls-labor-mcp-server; casey@caseyjhand.com)  # User-Agent for LABSTAT and API fetches — BLS data-access policy requires a descriptive UA with contact

# ── DataCanvas ────────────────────────────────────────────────────────
# CANVAS_PROVIDER_TYPE=none           # none | duckdb — set duckdb to enable tabular spillover for large result sets

# ── Observations mirror (opt-in, default OFF) ─────────────────────────
# BLS_OBSERVATIONS_MIRROR_ENABLED=false        # Set true to route observation fetches through the local SQLite mirror (requires one-time bootstrap)
# BLS_OBSERVATIONS_MIRROR_PATH=.mirror/bls-observations.db   # SQLite store path — mount a persistent volume here in containers
# BLS_OBSERVATIONS_MIRROR_REFRESH_CRON=0 6 * * 1   # Incremental refresh schedule (HTTP transport only; default Monday 06:00 UTC)
# BLS_OBSERVATIONS_MIRROR_FALLBACK_LIVE=true   # Fall back to live BLS API when mirror not ready or series missing (set false to enforce mirror-only)
